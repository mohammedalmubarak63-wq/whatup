import os
import re
from docx import Document

class WhatsAppSmartAgent:
    def __init__(self, input_txt_path, output_docx_path, extraction_mode="qa"):
        """
        الوكيل الذكي لمعالجة محادثات الواتساب:
        - input_txt_path: مسار ملف محادثات الواتساب المصدرة (_chat.txt)
        - output_docx_path: مسار ملف الوورد الناتج
        - extraction_mode: وضع الاستخراج (ماذا تريد من الوكيل أن يفعل؟)
          اختر أحد الأوضاع التالية:
          1. "qa"      -> لاستخراج الأسئلة وأجوبتها.
          2. "summary" -> لتلخيص النقاط والقرارات المهمة.
          3. "keywords"-> لاستخراج الرسائل التي تحتوي على كلمات مفتاحية معينة.
        """
        self.input_txt_path = input_txt_path
        self.output_docx_path = output_docx_path
        self.extraction_mode = extraction_mode

    def read_chat_file(self):
        """قراءة ملف المحادثة مع معالجة الترميزات المختلفة"""
        try:
            with open(self.input_txt_path, 'r', encoding='utf-8') as f:
                return f.readlines()
        except UnicodeDecodeError:
            with open(self.input_txt_path, 'r', encoding='latin-1') as f:
                return f.readlines()

    def parse_whatsapp_messages(self, lines):
        """تصفية وفصل رسائل الواتساب عن التواريخ وأسماء المرسلين بدقة"""
        messages = []
        # نمط متوافق مع تصدير واتساب (التاريخ، الوقت، المرسل، النص)
        pattern = re.compile(r'^\[?(\d{1,4}[-/.]\d{1,2}[-/.]\d{1,4}),?\s*[\d:]+\s*(?:ص|م|AM|PM)?\]?\s*-?\s*([^:]+):\s*(.*)')
        
        for line in lines:
            match = pattern.match(line.strip())
            if match:
                date, sender, text = match.groups()
                messages.append({"sender": sender.strip(), "text": text.strip()})
            else:
                # دمج الأسطر الطويلة أو المقسمة لرسالة واحدة
                if messages and line.strip():
                    messages[-1]["text"] += "\n" + line.strip()
        return messages

    def process_messages(self, messages):
        """
        هنا يتحقق الذكاء: كيف يعرف الوكيل ماذا تريد؟
        بناءً على النمط (Mode) الذي تختاره أنت في إعدادات الوكيل، يتم استخراج المطلوب حرفياً.
        """
        results = []
        
        if self.extraction_mode == "qa":
            # الوضع الأول: استخراج الأسئلة وأجوبتها بدقة
            i = 0
            while i < len(messages) - 1:
                current_msg = messages[i]['text']
                is_question = '؟' in current_msg or '?' in current_msg or any(current_msg.startswith(w) for w in ['هل', 'ما', 'من', 'كيف', 'متى', 'أين', 'لماذا', 'كم'])
                
                if is_question:
                    q_text = current_msg
                    a_text = ""
                    j = i + 1
                    while j < len(messages):
                        next_msg = messages[j]['text']
                        if '؟' in next_msg or '?' in next_msg:
                            break
                        a_text += ("\n" + next_msg) if a_text else next_msg
                        if j == i + 1:
                            break
                        j += 1
                    
                    if a_text:
                        results.append({
                            "title": f"السؤال من ({messages[i]['sender']}): {q_text}",
                            "content": f"الإجابة: {a_text.strip()}"
                        })
                i += 1

        elif self.extraction_mode == "summary":
            # الوضع الثاني: استخراج الجمل المهمة أو الروابط أو القرارات
            for msg in messages:
                text = msg['text']
                if any(k in text for k in ['قرار', 'مهم', 'مطلوب', 'موعد', 'تاريخ', 'http', 'www']):
                    results.append({
                        "title": f"مرسل من: {msg['sender']}",
                        "content": text
                    })
                    
        elif self.extraction_mode == "keywords":
            # الوضع الثالث: يمكنك تعديل الكلمة المفتاحية حسب رغبتك (مثلاً استخراج كل ما يخص موضوع معين)
            keyword = "مشروع" # يمكنك تغييرها لأي كلمة تبحث عنها
            for msg in messages:
                if keyword in msg['text']:
                    results.append({
                        "title": f"ذكر بواسطة: {msg['sender']}",
                        "content": msg['text']
                    })
                    
        return results

    def create_word_document(self, results):
        """إنشاء ملف الوورد وتنسيقه باحترافية تامة"""
        doc = Document()
        doc.add_heading('تقرير محتوى محادثات الواتساب المستخرج', level=0)
        
        if not results:
            doc.add_paragraph('لم يتم العثور على نتائج مطابقة للشروط المحددة.')
        
        for idx, item in enumerate(results, 1):
            # عنوان فرعي بخط عريض
            p_title = doc.add_paragraph()
            run_title = p_title.add_run(f"{idx}. {item['title']}")
            run_title.bold = True
            
            # المحتوى النصي كما هو دون تحريف
            p_content = doc.add_paragraph()
            p_content.add_run(item['content'])
            
            # خط فاصل مرتب بين النتائج
            doc.add_paragraph('--------------------------------------------------')

        doc.save(self.output_docx_path)
        print(f"✅ تم إنشاء ملف الوورد بنجاح في: {self.output_docx_path}")

    def run(self):
        if not os.path.exists(self.input_txt_path):
            print(f"❌ خطأ: ملف المحادثة غير موجود في المسار: {self.input_txt_path}")
            return
            
        print("📂 جاري قراءة ملف المحادثة...")
        lines = self.read_chat_file()
        
        print("🔍 جاري تحليل الرسائل...")
        messages = self.parse_whatsapp_messages(lines)
        
        print(f"🧠 جاري استخراج البيانات (وضع التشغيل: {self.extraction_mode})...")
        extracted_data = self.process_messages(messages)
        
        print(f"📊 تم استخراج {len(extracted_data)} نتيجة. جاري حفظ ملف الوورد...")
        self.create_word_document(extracted_data)
        print("🎉 تمت العملية بنجاح!")

# --- تشغيل الوكيل ---
if __name__ == "__main__":
    # ضع اسم ملف الواتساب الخاص بك هنا
    input_file = "_chat.txt"
    output_file = "WhatsApp_Extracted_Report.docx"
    
    # [مهم جداً] كيف يُميز التطبيق ما تريد؟
    # اختر الوضع الذي تحتاجه (qa للأسئلة والأجوبة، summary للملخصات والقرارات، keywords للكلمات المفتاحية)
    chosen_mode = "qa" 
    
    agent = WhatsAppSmartAgent(
        input_txt_path=input_file, 
        output_docx_path=output_file, 
        extraction_mode=chosen_mode
    )
    agent.run()
